# Copy to backend/.env for local development. On Railway, set these as service variables instead.

# PostGIS-enabled Postgres connection. On Railway use the PostGIS service's DATABASE_URL.
# After configuration: python -m alembic upgrade head
# DATABASE_URL=postgresql://geodiscover:geodiscover@localhost:5432/geodiscover

ENVIRONMENT=development

# Server-side provider diagnostics (never put secrets in VITE_* variables).
GOOGLE_PLACES_API_KEY=
GRAB_API_KEY=
GRAB_REGION=ap-southeast-1
# Places v2 does not require GRAB_PLACE_INDEX.
# Apple integration is not enabled. Provider access alone does not establish delivery rights.

# Only needed if the frontend is served from a different domain than the API.
# CORS_ORIGINS=http://localhost:5173
